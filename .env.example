# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys, and never paste them into a chat.
# Copy each value from the dashboard exactly as shown there.

# Canonical app origin for email confirmation/recovery links. Required for a production deployment.
# Add the callback URLs described in README.md to Supabase Auth > URL Configuration.
APP_URL=http://localhost:3000

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser; only reaches what row-level security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. It bypasses row-level security, so it must never reach the browser.
SUPABASE_SECRET_KEY=

# Postgres for Drizzle: Project Settings > Database > Connection string.
# Use the transaction pooler for app queries and a direct/session connection for migrations.
# DATABASE_URL: transaction pooler, port 6543, used by the app.
# DIRECT_DATABASE_URL: session pooler, port 5432, same host, used for migrations.
# Do not use db.<ref>.supabase.co: it resolves over IPv6 only and fails on many networks.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Vercel daily maintenance endpoint. Set a random value of at least 16 characters
# in the Vercel project environment; do not use a placeholder from this file.
CRON_SECRET=

# Anthropic, for AI goal suggestions: console.anthropic.com > Settings > API keys (sk-ant-...).
# Server only. This key is for the app's own features, not for any coding assistant.
ANTHROPIC_API_KEY=

# Which model writes goal suggestions. Haiku is the cheapest current Claude model
# ($1 per million input tokens, $5 per million output) and suits short drafting.
# Change this line to switch models; no code change needed. See docs/TECH_STACK.md.
ANTHROPIC_MODEL=claude-haiku-4-5
